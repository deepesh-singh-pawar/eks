# Copy to `terraform.tfvars` and adjust values for your AWS account constraints.

aws_region        = "us-east-1"
project_name      = "eks-learning"
environment       = "learning"
cluster_name      = "eks-learning"
kubernetes_version = "1.31"

# Cost / capacity tradeoff — t3.micro is cheaper but pods may fail to schedule under memory pressure.
node_instance_type = "t3.small"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 4

# Narrow this to YOUR public IP (/32) to reduce attack surface vs 0.0.0.0/0 .
# cluster_endpoint_public_access_cidrs = ["YOUR.PUBLIC.IP.ADDRESS/32"]
